# Copy to .env and fill in. This is the only file that differs between machines.
#   cp .env.example .env
#
# .env is deliberately untracked — it holds real credentials, and this repo is
# public. Nothing here may ever be committed with real values in it.
#
# These are used only by local tooling (curl tests, the validator and deployer
# agents). The app itself does NOT read this file: the phone and laptop each
# store their own copy in the browser's localStorage via the Settings screen.

# ---- backend ----------------------------------------------------------------
# The Apps Script Web App URL, ending in /exec. Get it from:
#   Apps Script editor → Deploy → Manage deployments → copy the Web app URL
# Anyone holding this URL *and* the token can write to your log, so treat the
# pair as one secret.
PROBEING_API_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# ---- auth -------------------------------------------------------------------
# Must match the TOKEN script property in the Apps Script project:
#   Apps Script editor → Project Settings → Script Properties → TOKEN
# Generate a fresh one with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
PROBEING_TOKEN=REPLACE_ME
