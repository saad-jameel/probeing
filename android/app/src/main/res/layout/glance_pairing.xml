<?xml version="1.0" encoding="utf-8"?>
<!--
    The pairing screen: the only screen this APK draws itself. Plain framework
    widgets throughout, so the app needs no UI library and the APK stays small.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/glance_pair_explainer"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/glance_pair_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textStyle="italic" />

        <EditText
            android:id="@+id/glance_secret_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/glance_pair_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/glance_pair_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/glance_pair_save" />

        <Button
            android:id="@+id/glance_pair_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/glance_pair_remove" />
    </LinearLayout>
</ScrollView>
