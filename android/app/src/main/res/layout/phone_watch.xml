<?xml version="1.0" encoding="utf-8"?>
<!-- Stage 18c: the phone activity screen. Plain framework widgets, like the widget's pairing screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_explainer"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/phone_usage_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/phone_usage_btn" />

        <LinearLayout
            android:id="@+id/phone_offer_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/phone_offer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_offer"
                android:textSize="14sp" />

            <Button
                android:id="@+id/phone_offer_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/phone_offer_btn" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/phone_paste_hint"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/phone_token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_paste_box"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/phone_paste_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_paste_btn" />

        <TextView
            android:id="@+id/phone_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/phone_send_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/phone_send_btn" />

        <Button
            android:id="@+id/phone_stop_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/phone_stop_btn" />
    </LinearLayout>
</ScrollView>
