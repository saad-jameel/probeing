<?xml version="1.0" encoding="utf-8"?>
<!--
    The tall widget: the list of open projects in place of the title, then the
    same body and footer as glance_widget.xml. GlanceWidget picks this layout
    only when the widget is tall enough; GlanceWords holds the sizes it assumes.

    The list's row takes whatever height is left, so a list longer than
    expected is clipped at its own bottom rather than pushing the figures and
    the "as of" line off the widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glance_background"
    android:padding="@dimen/glance_padding"
    android:theme="@style/Theme.ProBeing.GlanceWidget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/glance_lines"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/glance_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/glance_title"
                android:textSize="13sp"
                android:maxLines="24"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/glance_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/glance_reload"
            android:contentDescription="@string/glance_reload_description"
            android:textColor="@color/glance_accent"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/glance_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/glance_body"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/glance_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/glance_foot"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
